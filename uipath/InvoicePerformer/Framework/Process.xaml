    <ui:LogMessage DisplayName="Log Message Process Start" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Info" Message="[&quot;Started Process&quot;]" />
    <Assign x:TypeArguments="x:String" DisplayName="Assign filePath" sap2010:WorkflowViewState.IdRef="Assign_1" To="[filePath]" Value="[in_TransactionItem.SpecificContent(&quot;FilePath&quot;).ToString]" />
    <Assign x:TypeArguments="x:String" DisplayName="Assign erpUrl" sap2010:WorkflowViewState.IdRef="Assign_2" To="[erpUrl]" Value="[in_Config(&quot;ErpApiUrl&quot;).ToString.TrimEnd(&quot;/&quot;c)]" />
    <Assign x:TypeArguments="x:Int32" DisplayName="Assign erpTimeoutMs" sap2010:WorkflowViewState.IdRef="Assign_3" To="[erpTimeoutMs]" Value="[CInt(in_Config(&quot;ErpTimeoutMs&quot;))]" />
    <Assign x:TypeArguments="x:Double" DisplayName="Assign minConf" sap2010:WorkflowViewState.IdRef="Assign_4" To="[minConf]" Value="[CDbl(in_Config(&quot;MinFieldConfidence&quot;))]" />
    <If Condition="[Not File.Exists(filePath)]" DisplayName="If the scan is missing" sap2010:WorkflowViewState.IdRef="If_1">
      <If.Then>
        <Throw DisplayName="Throw system exception: input file not found" Exception="[New FileNotFoundException(&quot;Input file not found: &quot; &amp; filePath)]" sap2010:WorkflowViewState.IdRef="Throw_1" />
      </If.Then>
    </If>
    <!-- 1. Read the document with UiPath Document Understanding (Predefined project, pretrained Invoices extractor).
         A DU failure (service down, timeout) is an ordinary exception, so it becomes a system exception and the item is retried. -->
    <du:ExtractDocumentDataWithDocumentData x:TypeArguments="dux:DictionaryData" DisplayName="Extract Document Data (DU Invoices)" sap2010:WorkflowViewState.IdRef="ExtractDocumentDataWithDocumentData_1" ActivityMajorVersion="2" ProjectId="00000000-0000-0000-0000-000000000000" ProjectName="Predefined" ProjectTag="Production" ProjectVersionName="Production" ProjectVersionNumber="0" DocType="[&quot;invoices&quot;]" ExtractorName="Invoices" ModernDocumentTypeId="invoices" ModernDocumentTypeName="Invoices" GenerateData="False" FileInput="[LocalResource.FromPath(filePath)]" TimeoutInSeconds="[600]" ExtractionResults="[duResults]">
      <du:ExtractDocumentDataWithDocumentData.GptPromptWithVariables>
        <scg:Dictionary x:TypeArguments="x:String, InArgument(x:String)" />
      </du:ExtractDocumentDataWithDocumentData.GptPromptWithVariables>
    </du:ExtractDocumentDataWithDocumentData>
    <Assign x:TypeArguments="scg:Dictionary(x:String, x:String)" DisplayName="DU values by field id" sap2010:WorkflowViewState.IdRef="Assign_5" To="[duValues]" Value="[duResults.Data.GetFields().ToDictionary(Function(d) d.FieldId.Split(&quot;.&quot;c).Last(), Function(d) If(d.Values Is Nothing OrElse d.Values.Length = 0, CStr(Nothing), d.Values(0).Value))]" />
    <Assign x:TypeArguments="scg:Dictionary(x:String, x:Double)" DisplayName="DU confidence by field id (0-100)" sap2010:WorkflowViewState.IdRef="Assign_6" To="[duConf]" Value="[duResults.Data.GetFields().ToDictionary(Function(d) d.FieldId.Split(&quot;.&quot;c).Last(), Function(d) If(d.Values Is Nothing OrElse d.Values.Length = 0, 0.0, CDbl(d.Values(0).Confidence) * 100))]" />
    <!-- The pretrained Invoices model has no SIRET field: take it from DU's own OCR text (first 14 digits after "SIRET") -->
    <Assign x:TypeArguments="x:String" DisplayName="DU OCR text" sap2010:WorkflowViewState.IdRef="Assign_7" To="[ocrText]" Value="[If(duResults.DocumentMetadata.Text, &quot;&quot;)]" />
    <Assign x:TypeArguments="x:String" DisplayName="SIRET from DU OCR text" sap2010:WorkflowViewState.IdRef="Assign_19" To="[siret]" Value="[New String(Regex.Match(ocrText, &quot;(?i)siret\s*:?\s*([\d ]{14,20})&quot;).Groups(1).Value.Where(Function(c) Char.IsDigit(c)).Take(14).ToArray())]" />
    <Assign x:TypeArguments="scg:Dictionary(x:String, x:Object)" DisplayName="Map DU fields to the lab's field names" sap2010:WorkflowViewState.IdRef="Assign_20" To="[fieldMap]" Value="[New Dictionary(Of String, Object) From {{&quot;supplier_siret&quot;, If(siret.Length = 14, CObj(siret), Nothing)}, {&quot;invoice_number&quot;, duValues(&quot;invoice-no&quot;)}, {&quot;invoice_date&quot;, duValues(&quot;date&quot;)}, {&quot;po_number&quot;, duValues(&quot;po-no&quot;)}, {&quot;total_ht&quot;, If(duValues(&quot;net-amount&quot;) IsNot Nothing AndAlso Regex.IsMatch(duValues(&quot;net-amount&quot;), &quot;^-?\d+(\.\d+)?$&quot;), CObj(Double.Parse(duValues(&quot;net-amount&quot;), CultureInfo.InvariantCulture)), Nothing)}, {&quot;tva&quot;, If(duValues(&quot;tax&quot;) IsNot Nothing AndAlso Regex.IsMatch(duValues(&quot;tax&quot;), &quot;^-?\d+(\.\d+)?$&quot;), CObj(Double.Parse(duValues(&quot;tax&quot;), CultureInfo.InvariantCulture)), Nothing)}, {&quot;total_ttc&quot;, If(duValues(&quot;total&quot;) IsNot Nothing AndAlso Regex.IsMatch(duValues(&quot;total&quot;), &quot;^-?\d+(\.\d+)?$&quot;), CObj(Double.Parse(duValues(&quot;total&quot;), CultureInfo.InvariantCulture)), Nothing)}}]" />
    <Assign x:TypeArguments="njl:JObject" DisplayName="Assign fields" sap2010:WorkflowViewState.IdRef="Assign_21" To="[fields]" Value="[JObject.FromObject(fieldMap)]" />
    <Assign x:TypeArguments="njl:JObject" DisplayName="Assign conf" sap2010:WorkflowViewState.IdRef="Assign_22" To="[conf]" Value="[JObject.FromObject(New Dictionary(Of String, Double) From {{&quot;supplier_siret&quot;, 100.0}, {&quot;invoice_number&quot;, duConf(&quot;invoice-no&quot;)}, {&quot;invoice_date&quot;, duConf(&quot;date&quot;)}, {&quot;po_number&quot;, duConf(&quot;po-no&quot;)}, {&quot;total_ht&quot;, duConf(&quot;net-amount&quot;)}, {&quot;tva&quot;, duConf(&quot;tax&quot;)}, {&quot;total_ttc&quot;, duConf(&quot;total&quot;)}})]" />
    <Assign x:TypeArguments="njl:JObject" DisplayName="Assign extraction (missing fields, SIRET checksum)" sap2010:WorkflowViewState.IdRef="Assign_23" To="[extraction]" Value="[New JObject(New JProperty(&quot;missing&quot;, New JArray(fieldMap.Where(Function(kv) kv.Value Is Nothing).Select(Function(kv) CObj(kv.Key)).ToArray())), New JProperty(&quot;siret_checksum_ok&quot;, siret.Length = 14 AndAlso siret.Reverse().Select(Function(c, i) If(i Mod 2 = 1, If((AscW(c) - 48) * 2 &gt; 9, (AscW(c) - 48) * 2 - 9, (AscW(c) - 48) * 2), AscW(c) - 48)).Sum() Mod 10 = 0))]" />
    <ui:LogMessage DisplayName="Log DU extraction" sap2010:WorkflowViewState.IdRef="LogMessage_4" Level="Info" Message="[&quot;DU extracted: &quot; &amp; fields.ToString(Newtonsoft.Json.Formatting.None)]" />
    <Assign x:TypeArguments="x:String" DisplayName="Assign siret" sap2010:WorkflowViewState.IdRef="Assign_8" To="[siret]" Value="[If(fields(&quot;supplier_siret&quot;) Is Nothing, &quot;&quot;, fields(&quot;supplier_siret&quot;).ToString)]" />
    <!-- 2. Rule: every required field read, SIRET checksum valid -->
    <Assign x:TypeArguments="x:String" DisplayName="Assign invalidFields" sap2010:WorkflowViewState.IdRef="Assign_9" To="[invalidFields]" Value="[String.Join(&quot;, &quot;, extraction(&quot;missing&quot;).Select(Function(t) t.ToString).Concat(If(siret &lt;&gt; &quot;&quot; AndAlso Not CBool(extraction(&quot;siret_checksum_ok&quot;)), New String() {&quot;supplier_siret&quot;}, New String() {})).Distinct().OrderBy(Function(n) n, StringComparer.Ordinal))]" />
    <!-- 3. Rule: invoice number and date read with enough OCR confidence -->
    <Assign x:TypeArguments="x:String" DisplayName="Assign lowConfidence" sap2010:WorkflowViewState.IdRef="Assign_10" To="[lowConfidence]" Value="[String.Join(&quot;, &quot;, New String() {&quot;invoice_number&quot;, &quot;invoice_date&quot;}.Where(Function(k) conf(k) IsNot Nothing AndAlso conf(k).Type &lt;&gt; JTokenType.Null AndAlso CDbl(conf(k)) &lt; minConf))]" />
    <Assign x:TypeArguments="x:String" DisplayName="Assign reviewReason" sap2010:WorkflowViewState.IdRef="Assign_24" To="[reviewReason]" Value="[If(invalidFields &lt;&gt; &quot;&quot;, &quot;Unreadable or invalid fields: &quot; &amp; invalidFields, If(lowConfidence &lt;&gt; &quot;&quot;, &quot;Low OCR confidence on &quot; &amp; lowConfidence, &quot;&quot;))]" />
    <!-- Needs a human: open a Document Validation task in Action Center (no wait, so no persistence needed), then stop the item as a business exception -->
    <If Condition="[reviewReason &lt;&gt; &quot;&quot;]" DisplayName="If the extraction needs a human" sap2010:WorkflowViewState.IdRef="If_3">
      <If.Then>
        <Sequence DisplayName="Route to Action Center" sap2010:WorkflowViewState.IdRef="Sequence_3">
          <TryCatch DisplayName="Try create validation task" sap2010:WorkflowViewState.IdRef="TryCatch_1">
            <TryCatch.Try>
              <Sequence DisplayName="Create task" sap2010:WorkflowViewState.IdRef="Sequence_4">
                <duVal:CreateValidationAction x:TypeArguments="dux:DictionaryData" DisplayName="Create Validation Task" sap2010:WorkflowViewState.IdRef="CreateValidationAction_1" AutomaticExtractionResults="[duResults]" ActionTitle="[&quot;Invoice review: &quot; &amp; in_TransactionItem.SpecificContent(&quot;FileName&quot;).ToString &amp; &quot; - &quot; &amp; reviewReason]" ActionPriority="[&quot;Medium&quot;]" OrchestratorFolderName="[&quot;Shared&quot;]" CreatedValidationAction="[validationTask]" />
                <ui:LogMessage DisplayName="Log task created" sap2010:WorkflowViewState.IdRef="LogMessage_5" Level="Info" Message="[&quot;Action Center validation task created for &quot; &amp; in_TransactionItem.SpecificContent(&quot;FileName&quot;).ToString]" />
              </Sequence>
            </TryCatch.Try>
            <TryCatch.Catches>
              <Catch x:TypeArguments="s:Exception" sap2010:WorkflowViewState.IdRef="Catch_1">
                <ActivityAction x:TypeArguments="s:Exception">
                  <ActivityAction.Argument>
                    <DelegateInArgument x:TypeArguments="s:Exception" Name="taskError" />
                  </ActivityAction.Argument>
                  <ui:LogMessage DisplayName="Log task failure" sap2010:WorkflowViewState.IdRef="LogMessage_6" Level="Warn" Message="[&quot;Action Center task NOT created: &quot; &amp; taskError.GetType().Name &amp; &quot;: &quot; &amp; taskError.Message]" />
                </ActivityAction>
              </Catch>
            </TryCatch.Catches>
          </TryCatch>
          <Throw DisplayName="Throw BE_EXTRACTION_REVIEW" Exception="[New BusinessRuleException(&quot;BE_EXTRACTION_REVIEW: &quot; &amp; reviewReason)]" sap2010:WorkflowViewState.IdRef="Throw_3" />
        </Sequence>
      </If.Then>
    </If>
    <Assign x:TypeArguments="x:String" DisplayName="Assign invoiceNumber" sap2010:WorkflowViewState.IdRef="Assign_11" To="[invoiceNumber]" Value="[fields(&quot;invoice_number&quot;).ToString]" />
    <Assign x:TypeArguments="x:String" DisplayName="Assign poNumber" sap2010:WorkflowViewState.IdRef="Assign_12" To="[poNumber]" Value="[fields(&quot;po_number&quot;).ToString]" />
    <Assign x:TypeArguments="x:Double" DisplayName="Assign ht" sap2010:WorkflowViewState.IdRef="Assign_13" To="[ht]" Value="[CDbl(fields(&quot;total_ht&quot;))]" />
    <Assign x:TypeArguments="x:Double" DisplayName="Assign tva" sap2010:WorkflowViewState.IdRef="Assign_14" To="[tva]" Value="[CDbl(fields(&quot;tva&quot;))]" />
    <Assign x:TypeArguments="x:Double" DisplayName="Assign ttc" sap2010:WorkflowViewState.IdRef="Assign_15" To="[ttc]" Value="[CDbl(fields(&quot;total_ttc&quot;))]" />
    <!-- 4. Rule: HT + TVA = TTC and TVA = HT x rate (catches supplier errors and OCR misreads) -->
    <If Condition="[Math.Abs(ht + tva - ttc) &gt; 0.011 OrElse Math.Abs(Math.Round(ht * CDbl(in_Config(&quot;VatRate&quot;)), 2) - tva) &gt; 0.011]" DisplayName="If totals are inconsistent" sap2010:WorkflowViewState.IdRef="If_5">
      <If.Then>
        <If Condition="[New String() {&quot;total_ht&quot;, &quot;tva&quot;, &quot;total_ttc&quot;}.Any(Function(k) conf(k) IsNot Nothing AndAlso conf(k).Type &lt;&gt; JTokenType.Null AndAlso CDbl(conf(k)) &lt; minConf)]" DisplayName="If an amount was read with low confidence" sap2010:WorkflowViewState.IdRef="If_6">
          <If.Then>
            <Throw DisplayName="Throw BE_EXTRACTION_REVIEW (amounts)" Exception="[New BusinessRuleException(&quot;BE_EXTRACTION_REVIEW: Totals inconsistent and an amount was read with low confidence&quot;)]" sap2010:WorkflowViewState.IdRef="Throw_5" />
          </If.Then>
          <If.Else>
            <Throw DisplayName="Throw BE_TOTAL_MISMATCH" Exception="[New BusinessRuleException(&quot;BE_TOTAL_MISMATCH: HT &quot; &amp; ht.ToString(Globalization.CultureInfo.InvariantCulture) &amp; &quot; + TVA &quot; &amp; tva.ToString(Globalization.CultureInfo.InvariantCulture) &amp; &quot; != TTC &quot; &amp; ttc.ToString(Globalization.CultureInfo.InvariantCulture))]" sap2010:WorkflowViewState.IdRef="Throw_6" />
          </If.Else>
        </If>
      </If.Then>
    </If>
    <!-- 5. Rule: supplier exists in the ERP register -->
    <uwah:NetHttpRequest AuthenticationType="None" ContinueOnError="False" DisplayName="HTTP Request ERP supplier" EnableCookies="False" FollowRedirects="True" sap2010:WorkflowViewState.IdRef="NetHttpRequest_2" Method="GET" RequestBodyType="None" RequestUrl="[erpUrl &amp; &quot;/suppliers/&quot; &amp; Uri.EscapeDataString(siret)]" Result="[resp]" RetryPolicyType="None" SaveRawRequestResponse="False" SaveResponseAsFile="False" TlsProtocol="Automatic">
      <uwah:NetHttpRequest.TimeoutInMiliseconds>
        <InArgument x:TypeArguments="s:Nullable(x:Int32)">[erpTimeoutMs]</InArgument>
      </uwah:NetHttpRequest.TimeoutInMiliseconds>
    </uwah:NetHttpRequest>
    <If Condition="[CInt(resp.StatusCode) &gt;= 500]" DisplayName="If ERP failed (supplier)" sap2010:WorkflowViewState.IdRef="If_7">
      <If.Then>
        <Throw DisplayName="Throw system exception: ERP supplier" Exception="[New Exception(&quot;ERP &quot; &amp; CInt(resp.StatusCode).ToString &amp; &quot; on GET /suppliers&quot;)]" sap2010:WorkflowViewState.IdRef="Throw_7" />
      </If.Then>
    </If>
    <If Condition="[CInt(resp.StatusCode) = 404]" DisplayName="If supplier unknown" sap2010:WorkflowViewState.IdRef="If_8">
      <If.Then>
        <Throw DisplayName="Throw BE_UNKNOWN_SUPPLIER" Exception="[New BusinessRuleException(&quot;BE_UNKNOWN_SUPPLIER: SIRET &quot; &amp; siret &amp; &quot; not in the supplier register&quot;)]" sap2010:WorkflowViewState.IdRef="Throw_8" />
      </If.Then>
    </If>
    <!-- 6. Rule: not already booked (and recover a booking whose response was lost) -->
    <uwah:NetHttpRequest AuthenticationType="None" ContinueOnError="False" DisplayName="HTTP Request ERP existing invoices" EnableCookies="False" FollowRedirects="True" sap2010:WorkflowViewState.IdRef="NetHttpRequest_3" Method="GET" RequestBodyType="None" RequestUrl="[erpUrl &amp; &quot;/invoices?supplier_siret=&quot; &amp; Uri.EscapeDataString(siret) &amp; &quot;&amp;invoice_number=&quot; &amp; Uri.EscapeDataString(invoiceNumber)]" Result="[resp]" RetryPolicyType="None" SaveRawRequestResponse="False" SaveResponseAsFile="False" TlsProtocol="Automatic">
      <uwah:NetHttpRequest.TimeoutInMiliseconds>
        <InArgument x:TypeArguments="s:Nullable(x:Int32)">[erpTimeoutMs]</InArgument>
      </uwah:NetHttpRequest.TimeoutInMiliseconds>
    </uwah:NetHttpRequest>
    <If Condition="[CInt(resp.StatusCode) &lt;&gt; 200]" DisplayName="If ERP failed (invoices)" sap2010:WorkflowViewState.IdRef="If_9">
      <If.Then>
        <Throw DisplayName="Throw system exception: ERP invoices" Exception="[New Exception(&quot;ERP &quot; &amp; CInt(resp.StatusCode).ToString &amp; &quot; on GET /invoices&quot;)]" sap2010:WorkflowViewState.IdRef="Throw_9" />
      </If.Then>
    </If>
    <Assign x:TypeArguments="njl:JArray" DisplayName="Parse existing invoices" sap2010:WorkflowViewState.IdRef="Assign_16" To="[existing]" Value="[JArray.Parse(resp.TextContent)]" />
    <Assign x:TypeArguments="x:Int32" DisplayName="Count bookings made by this queue item" sap2010:WorkflowViewState.IdRef="Assign_17" To="[bookedByThisItem]" Value="[existing.Where(Function(e) e(&quot;idempotency_key&quot;) IsNot Nothing AndAlso e(&quot;idempotency_key&quot;).ToString = in_TransactionItem.Reference).Count()]" />
    <If Condition="[bookedByThisItem &gt; 0]" DisplayName="If an earlier attempt of this item already booked it" sap2010:WorkflowViewState.IdRef="If_10">
      <If.Then>
        <ui:LogMessage DisplayName="Log recovered lost response" sap2010:WorkflowViewState.IdRef="LogMessage_2" Level="Warn" Message="[&quot;Invoice already booked by an earlier attempt of this item (lost response recovered), reference &quot; &amp; in_TransactionItem.Reference]" />
      </If.Then>
      <If.Else>
        <Sequence DisplayName="Check PO and book" sap2010:WorkflowViewState.IdRef="Sequence_2">
          <If Condition="[existing.Count &gt; 0]" DisplayName="If invoice already booked" sap2010:WorkflowViewState.IdRef="If_11">
            <If.Then>
              <Throw DisplayName="Throw BE_DUPLICATE_INVOICE" Exception="[New BusinessRuleException(&quot;BE_DUPLICATE_INVOICE: Invoice &quot; &amp; invoiceNumber &amp; &quot; already booked on &quot; &amp; existing(0)(&quot;booked_on&quot;).ToString)]" sap2010:WorkflowViewState.IdRef="Throw_10" />
            </If.Then>
          </If>
          <!-- 7. Rule: open purchase order for this supplier, amount within tolerance -->
          <uwah:NetHttpRequest AuthenticationType="None" ContinueOnError="False" DisplayName="HTTP Request ERP purchase order" EnableCookies="False" FollowRedirects="True" sap2010:WorkflowViewState.IdRef="NetHttpRequest_4" Method="GET" RequestBodyType="None" RequestUrl="[erpUrl &amp; &quot;/purchase-orders/&quot; &amp; Uri.EscapeDataString(poNumber)]" Result="[resp]" RetryPolicyType="None" SaveRawRequestResponse="False" SaveResponseAsFile="False" TlsProtocol="Automatic">
            <uwah:NetHttpRequest.TimeoutInMiliseconds>
              <InArgument x:TypeArguments="s:Nullable(x:Int32)">[erpTimeoutMs]</InArgument>
            </uwah:NetHttpRequest.TimeoutInMiliseconds>
          </uwah:NetHttpRequest>
          <If Condition="[CInt(resp.StatusCode) &gt;= 500]" DisplayName="If ERP failed (PO)" sap2010:WorkflowViewState.IdRef="If_12">
            <If.Then>
              <Throw DisplayName="Throw system exception: ERP PO" Exception="[New Exception(&quot;ERP &quot; &amp; CInt(resp.StatusCode).ToString &amp; &quot; on GET /purchase-orders&quot;)]" sap2010:WorkflowViewState.IdRef="Throw_11" />
            </If.Then>
          </If>
          <If Condition="[CInt(resp.StatusCode) = 404 OrElse JObject.Parse(resp.TextContent)(&quot;supplier_siret&quot;).ToString &lt;&gt; siret]" DisplayName="If no open PO for this supplier" sap2010:WorkflowViewState.IdRef="If_13">
            <If.Then>
              <Throw DisplayName="Throw BE_PO_NOT_FOUND" Exception="[New BusinessRuleException(&quot;BE_PO_NOT_FOUND: No open purchase order &quot; &amp; poNumber &amp; &quot; for this supplier&quot;)]" sap2010:WorkflowViewState.IdRef="Throw_12" />
            </If.Then>
          </If>
          <Assign x:TypeArguments="njl:JObject" DisplayName="Parse PO" sap2010:WorkflowViewState.IdRef="Assign_18" To="[po]" Value="[JObject.Parse(resp.TextContent)]" />
          <If Condition="[Math.Abs(CDbl(po(&quot;amount_ht&quot;)) - ht) &gt; CDbl(po(&quot;amount_ht&quot;)) * CDbl(in_Config(&quot;PoAmountTolerancePct&quot;)) / 100]" DisplayName="If invoice amount differs from the PO" sap2010:WorkflowViewState.IdRef="If_14">
            <If.Then>
              <Throw DisplayName="Throw BE_PO_AMOUNT_MISMATCH" Exception="[New BusinessRuleException(&quot;BE_PO_AMOUNT_MISMATCH: Invoice HT &quot; &amp; ht.ToString(Globalization.CultureInfo.InvariantCulture) &amp; &quot; vs PO &quot; &amp; po(&quot;amount_ht&quot;).ToString)]" sap2010:WorkflowViewState.IdRef="Throw_13" />
            </If.Then>
          </If>
          <!-- 8. Book it. The Idempotency-Key makes a retry after a lost response safe. -->
          <uwah:NetHttpRequest AuthenticationType="None" ContinueOnError="False" DisplayName="HTTP Request ERP book invoice" EnableCookies="False" FollowRedirects="True" Headers="[New Dictionary(Of String, String) From {{&quot;Idempotency-Key&quot;, in_TransactionItem.Reference}}]" sap2010:WorkflowViewState.IdRef="NetHttpRequest_5" Method="POST" RequestBodyType="Text" RequestUrl="[erpUrl &amp; &quot;/invoices&quot;]" Result="[resp]" RetryPolicyType="None" SaveRawRequestResponse="False" SaveResponseAsFile="False" TextPayload="[fields.ToString(Newtonsoft.Json.Formatting.None)]" TextPayloadContentType="application/json" TextPayloadEncoding="UTF-8" TlsProtocol="Automatic">
            <uwah:NetHttpRequest.TimeoutInMiliseconds>
              <InArgument x:TypeArguments="s:Nullable(x:Int32)">[erpTimeoutMs]</InArgument>
            </uwah:NetHttpRequest.TimeoutInMiliseconds>
          </uwah:NetHttpRequest>
          <If Condition="[CInt(resp.StatusCode) &lt;&gt; 201 AndAlso CInt(resp.StatusCode) &lt;&gt; 200]" DisplayName="If booking failed" sap2010:WorkflowViewState.IdRef="If_15">
            <If.Then>
              <Throw DisplayName="Throw system exception: ERP booking" Exception="[New Exception(&quot;ERP &quot; &amp; CInt(resp.StatusCode).ToString &amp; &quot; on POST /invoices&quot;)]" sap2010:WorkflowViewState.IdRef="Throw_14" />
            </If.Then>
          </If>
          <ui:LogMessage DisplayName="Log booked" sap2010:WorkflowViewState.IdRef="LogMessage_3" Level="Info" Message="[&quot;Booked in ERP: id &quot; &amp; JObject.Parse(resp.TextContent)(&quot;id&quot;).ToString &amp; &quot;, invoice &quot; &amp; invoiceNumber]" />
        </Sequence>
      </If.Else>
    </If>
  </Sequence>
</Activity>