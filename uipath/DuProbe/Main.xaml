  <Sequence DisplayName="DU probe: pretrained Invoices extractor" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Default="C:\Users\ASUS\Desktop\Projects\rpa-document-automation-lab\data\inbox" Name="inboxFolder" />
      <Variable x:TypeArguments="x:Int32" Default="6" Name="sampleSize" />
    </Sequence.Variables>
    <ui:LogMessage DisplayName="Log start" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Info" Message="[&quot;DU probe started on &quot; &amp; sampleSize.ToString &amp; &quot; invoices from &quot; &amp; inboxFolder]" />
    <ui:ForEach x:TypeArguments="x:String" CurrentIndex="{x:Null}" DisplayName="For Each sample invoice" sap2010:WorkflowViewState.IdRef="ForEach`1_1" Values="[Directory.GetFiles(inboxFolder).Where(Function(f) Not Path.GetFileName(f).Contains(&quot;_renvoi&quot;) AndAlso New String() {&quot;.png&quot;, &quot;.jpg&quot;, &quot;.jpeg&quot;}.Contains(Path.GetExtension(f).ToLowerInvariant())).OrderBy(Function(f) f, StringComparer.Ordinal).Take(sampleSize).ToArray()]">
      <ui:ForEach.Body>
        <ActivityAction x:TypeArguments="x:String">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="x:String" Name="filePath" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Body" sap2010:WorkflowViewState.IdRef="Sequence_2">
            <Sequence.Variables>
              <Variable x:TypeArguments="dux:IDocumentData(dux:DictionaryData)" Name="extractionResults" />
            </Sequence.Variables>
            <TryCatch DisplayName="Try extract" sap2010:WorkflowViewState.IdRef="TryCatch_1">
              <TryCatch.Try>
                <Sequence DisplayName="Extract and log" sap2010:WorkflowViewState.IdRef="Sequence_3">
                  <du:ExtractDocumentDataWithDocumentData x:TypeArguments="dux:DictionaryData" DisplayName="Extract Document Data" sap2010:WorkflowViewState.IdRef="ExtractDocumentDataWithDocumentData_1" ActivityMajorVersion="2" ProjectId="00000000-0000-0000-0000-000000000000" ProjectName="Predefined" ProjectTag="Production" ProjectVersionName="Production" ProjectVersionNumber="0" DocType="[&quot;invoices&quot;]" ExtractorName="Invoices" ModernDocumentTypeId="invoices" ModernDocumentTypeName="Invoices" GenerateData="False" FileInput="[LocalResource.FromPath(filePath)]" TimeoutInSeconds="[600]" ExtractionResults="[extractionResults]">
                    <du:ExtractDocumentDataWithDocumentData.GptPromptWithVariables>
                      <scg:Dictionary x:TypeArguments="x:String, InArgument(x:String)" />
                    </du:ExtractDocumentDataWithDocumentData.GptPromptWithVariables>
                  </du:ExtractDocumentDataWithDocumentData>
                  <ui:LogMessage DisplayName="Log fields" sap2010:WorkflowViewState.IdRef="LogMessage_2" Level="Info" Message="[&quot;DU &quot; &amp; Path.GetFileName(filePath) &amp; &quot; :: &quot; &amp; String.Join(&quot; || &quot;, extractionResults.Data.GetFields().Select(Function(d) d.FieldId &amp; &quot;=&quot; &amp; If(d.Values Is Nothing OrElse d.Values.Length = 0, &quot;&lt;missing&gt;&quot;, d.Values(0).Value &amp; &quot; @&quot; &amp; d.Values(0).Confidence.ToString(&quot;0.00&quot;, CultureInfo.InvariantCulture))))]" />
                </Sequence>
              </TryCatch.Try>
              <TryCatch.Catches>
                <Catch x:TypeArguments="s:Exception" sap2010:WorkflowViewState.IdRef="Catch_1">
                  <ActivityAction x:TypeArguments="s:Exception">
                    <ActivityAction.Argument>
                      <DelegateInArgument x:TypeArguments="s:Exception" Name="exception" />
                    </ActivityAction.Argument>
                    <ui:LogMessage DisplayName="Log failure" sap2010:WorkflowViewState.IdRef="LogMessage_3" Level="Error" Message="[&quot;DU FAILED &quot; &amp; Path.GetFileName(filePath) &amp; &quot; :: &quot; &amp; exception.GetType().Name &amp; &quot;: &quot; &amp; exception.Message]" />
                  </ActivityAction>
                </Catch>
              </TryCatch.Catches>
            </TryCatch>
          </Sequence>
        </ActivityAction>
      </ui:ForEach.Body>
    </ui:ForEach>
    <ui:LogMessage DisplayName="Log end" sap2010:WorkflowViewState.IdRef="LogMessage_4" Level="Info" Message="DU probe finished" />
